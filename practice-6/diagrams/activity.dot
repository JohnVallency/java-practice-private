digraph Activity {
    graph [label="Маршрутизация заявки — вариант 27", labelloc=t, fontname="DejaVu Sans", fontsize=24, dpi=160];
    node [shape=box, fontname="DejaVu Sans", fontsize=16, margin="0.15,0.1"];
    edge [fontname="DejaVu Sans", fontsize=14];
    start [shape=circle, label="", style=filled, width=0.25];
    input [label="Получить amount, urgent, risk,\ncontainsPersonalData, department"];
    valid [shape=diamond, label="amount ≥ 0\nи risk не null?"];
    error [label="Выбросить IllegalArgumentException"];
    personal [shape=diamond, label="Есть персональные\nданные?"];
    high [shape=diamond, label="Риск HIGH?"];
    it [shape=diamond, label="Срочная IT-заявка?\naddDepartmentPriority = 1"];
    finance [shape=diamond, label="Сумма ≥ FINANCE_LIMIT?"];
    urgent [shape=diamond, label="Срочная и сумма\n< FINANCE_LIMIT?"];
    securityResult [label="Вернуть SECURITY_REVIEW"];
    directorResult [label="Вернуть DIRECTOR_REVIEW"];
    financeResult [label="Вернуть FINANCE_REVIEW"];
    fastResult [label="Вернуть FAST_TRACK"];
    standardResult [label="Вернуть STANDARD"];
    end [shape=doublecircle, label="", width=0.3];
    start -> input -> valid;
    valid -> error [label="нет"];
    error -> end;
    valid -> personal [label="да"];
    personal -> securityResult [label="да"];
    personal -> high [label="нет"];
    high -> directorResult [label="да"];
    high -> it [label="нет"];
    it -> fastResult [label="да"];
    it -> finance [label="нет"];
    finance -> financeResult [label="да"];
    finance -> urgent [label="нет"];
    urgent -> fastResult [label="да"];
    urgent -> standardResult [label="нет"];
    securityResult -> end;
    directorResult -> end;
    financeResult -> end;
    fastResult -> end;
    standardResult -> end;
}
